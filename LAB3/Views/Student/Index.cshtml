@model IEnumerable<LAB2.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container mt-4">
    <h2>Danh sách Sinh viên</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Create Student</a>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Name</td>
                    <td>@s.DateOfBorth.ToString("dd/MM/yyyy")</td>
                    <td>
                        @{
                            string str = "";
                            switch (s.Branch)
                            {
                                case Branch.IT: str = "CNTT"; break;
                                case Branch.BE: str = "Kinh tế"; break;
                                case Branch.CE: str = "Công trình"; break;
                                case Branch.EE: str = "Điện - Điện tử"; break;
                            }
                        }
                        @str
                    </td>
                    <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                    <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@s.Address</td>
                    <td>@s.Email</td>
                    <td>
                        @if (!string.IsNullOrEmpty(s.AvatarUrl))
                        {
                            <img src="~/images/@s.AvatarUrl" alt="Avatar" width="50" height="50" class="rounded-circle" />
                        }
                        else
                        {
                            <span class="text-muted">Chưa có ảnh</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style = "background-color: yellow;";
        }
    </script>
}